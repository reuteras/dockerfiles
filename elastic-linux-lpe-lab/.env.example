# Copy this file to .env and replace every change-me value.
ELASTIC_PASSWORD=change-me-elastic
ELASTIC_VERSION=9.5.3
KIBANA_ENCRYPTION_KEY=change-this-to-at-least-32-characters-long
KIBANA_PASSWORD=change-me-kibana

# Populate these after creating a Fleet Server policy in Kibana.
FLEET_SERVER_POLICY_ID=fleet-server-policy
FLEET_SERVER_SERVICE_TOKEN=replace-me
